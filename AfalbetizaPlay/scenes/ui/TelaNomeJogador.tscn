[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/tela_nome_jogador.gd" id="1"]

[node name="TelaNomeJogador" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Fundo" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(1, 0.95, 0.85, 1)

[node name="Painel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -220.0
offset_top = -190.0
offset_right = 220.0
offset_bottom = 190.0
grow_horizontal = 2
grow_vertical = 2

[node name="Caixa" type="VBoxContainer" parent="Painel"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Titulo" type="Label" parent="Painel/Caixa"]
layout_mode = 2
theme_override_font_sizes/font_size = 30
text = "Quem vai jogar hoje?"
horizontal_alignment = 1
autowrap_mode = 2

[node name="LabelNome" type="Label" parent="Painel/Caixa"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Nome"

[node name="CampoNome" type="LineEdit" parent="Painel/Caixa"]
layout_mode = 2
placeholder_text = "Digite seu nome"
max_length = 40

[node name="LabelTurma" type="Label" parent="Painel/Caixa"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Turma / Série"

[node name="CampoTurma" type="LineEdit" parent="Painel/Caixa"]
layout_mode = 2
placeholder_text = "Ex: 3º Ano B"
max_length = 40

[node name="LabelErro" type="Label" parent="Painel/Caixa"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.15, 0.15, 1)
text = "Preencha os dois campos pra continuar"
horizontal_alignment = 1
autowrap_mode = 2
visible = false

[node name="BotaoComecar" type="Button" parent="Painel/Caixa"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "COMEÇAR"

[connection signal="pressed" from="Painel/Caixa/BotaoComecar" to="." method="_on_botao_comecar_pressed"]
[connection signal="text_submitted" from="Painel/Caixa/CampoNome" to="." method="_on_campo_text_submitted"]
[connection signal="text_submitted" from="Painel/Caixa/CampoTurma" to="." method="_on_campo_text_submitted"]
